{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growthos.local/schemas/wiserr-reactivation-command.schema.json",
  "title": "GrowthOS Wiserr Reactivation Command",
  "type": "object",
  "required": [
    "schemaVersion",
    "commandId",
    "tenantId",
    "actionId",
    "actionHash",
    "campaignId",
    "opportunityId",
    "experimentId",
    "planId",
    "planApprovalHash",
    "campaignApprovalId",
    "policyReceiptId",
    "policyReceiptHash",
    "envelopeId",
    "envelopeHash",
    "attemptId",
    "attemptNumber",
    "idempotencyKey",
    "originalBusinessSnapshotId",
    "executionBusinessSnapshotId",
    "cohortDefinitionId",
    "cohortDefinitionVersion",
    "channel",
    "accountId",
    "geography",
    "maxRecipients",
    "message",
    "frequencyPolicy",
    "commandHash"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "commandId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "actionId": { "type": "string", "minLength": 1 },
    "actionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "campaignId": { "type": "string", "minLength": 1 },
    "opportunityId": { "type": "string", "minLength": 1 },
    "experimentId": { "type": "string", "minLength": 1 },
    "planId": { "type": "string", "minLength": 1 },
    "planApprovalHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "campaignApprovalId": { "type": "string", "minLength": 1 },
    "policyReceiptId": { "type": "string", "minLength": 1 },
    "policyReceiptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "envelopeId": { "type": "string", "minLength": 1 },
    "envelopeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "attemptId": { "type": "string", "minLength": 1 },
    "attemptNumber": { "type": "integer", "minimum": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "originalBusinessSnapshotId": { "type": "string", "minLength": 1 },
    "executionBusinessSnapshotId": { "type": "string", "minLength": 1 },
    "cohortDefinitionId": { "type": "string", "minLength": 1 },
    "cohortDefinitionVersion": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "minLength": 1 },
    "accountId": { "type": "string", "minLength": 1 },
    "geography": { "type": "string", "minLength": 1 },
    "maxRecipients": { "type": "integer", "minimum": 1 },
    "message": { "type": "object" },
    "frequencyPolicy": { "type": "object" },
    "commandHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
