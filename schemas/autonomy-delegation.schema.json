{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growthos.local/schemas/autonomy-delegation.schema.json",
  "title": "GrowthOS Autonomy Delegation Assertion",
  "type": "object",
  "required": [
    "schemaVersion",
    "assertionId",
    "tenantId",
    "subjectId",
    "issuerSystem",
    "issuerAuthorityRef",
    "status",
    "validFrom",
    "validUntil",
    "actionFamilies",
    "maxAutonomyLevel",
    "scopes",
    "limitCeilings",
    "canActivateEnvelopes",
    "canRevokeEnvelopes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assertionId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "subjectId": { "type": "string", "minLength": 1 },
    "issuerSystem": { "type": "string", "minLength": 1 },
    "issuerAuthorityRef": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ACTIVE", "REVOKED", "EXPIRED"] },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "actionFamilies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "maxAutonomyLevel": {
      "enum": ["L0_OBSERVE", "L1_RECOMMEND", "L2_DRAFT", "L3_APPROVAL_REQUIRED", "L4_BOUNDED_AUTONOMOUS", "L5_LOW_RISK_AUTONOMOUS"]
    },
    "scopes": {
      "type": "object",
      "required": ["channels", "accountIds", "geographies"],
      "properties": {
        "channels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "accountIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "geographies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "limitCeilings": {
      "type": "object",
      "required": ["maxSpendUsdPerDay", "maxSpendUsdTotal", "maxChangePercent", "maxAttempts", "maxRecipients"],
      "properties": {
        "maxSpendUsdPerDay": { "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "UNBOUNDED" }] },
        "maxSpendUsdTotal": { "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "UNBOUNDED" }] },
        "maxChangePercent": { "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "UNBOUNDED" }] },
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "maxRecipients": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "const": "UNBOUNDED" }] }
      },
      "additionalProperties": false
    },
    "canActivateEnvelopes": { "type": "boolean" },
    "canRevokeEnvelopes": { "type": "boolean" },
    "evidenceRef": { "type": ["string", "null"] },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
