{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growthos.local/schemas/opportunity.schema.json",
  "title": "GrowthOS Opportunity",
  "type": "object",
  "required": ["schemaVersion", "opportunityId", "tenantId", "type", "status", "detectedAt", "businessSnapshotId", "evidence", "expectedImpact", "uncertainty", "requiredAutonomyLevel"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "opportunityId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "type": {
      "enum": [
        "DORMANT_LEAD_REACTIVATION",
        "INACTIVE_CUSTOMER_REACTIVATION",
        "UNACCEPTED_ESTIMATE_FOLLOWUP",
        "NO_SHOW_RECOVERY",
        "REVIEW_REFERRAL",
        "LOCAL_REPUTATION",
        "CONTENT_GAP",
        "SEO_GEO_GAP",
        "PAID_ACQUISITION",
        "CONVERSION_LEAK",
        "DEMAND_THROTTLE",
        "OTHER"
      ]
    },
    "status": { "enum": ["DETECTED", "PRIORITIZED", "DEFERRED", "DISMISSED", "PLANNED", "CLOSED"] },
    "detectedAt": { "type": "string", "format": "date-time" },
    "businessSnapshotId": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "reference", "summary"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "expectedImpact": {
      "type": "object",
      "required": ["metric", "low", "high"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "low": { "type": ["number", "null"] },
        "high": { "type": ["number", "null"] },
        "units": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "uncertainty": { "enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"] },
    "urgency": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "operationalFeasibility": { "enum": ["FEASIBLE", "CONSTRAINED", "BLOCKED", "UNKNOWN"] },
    "requiredAutonomyLevel": { "enum": ["L0_OBSERVE", "L1_RECOMMEND", "L2_DRAFT", "L3_APPROVAL_REQUIRED", "L4_BOUNDED_AUTONOMOUS", "L5_LOW_RISK_AUTONOMOUS"] },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
