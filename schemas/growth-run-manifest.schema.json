{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growthos.local/schemas/growth-run-manifest.schema.json",
  "title": "GrowthOS Growth Run Manifest",
  "type": "object",
  "required": ["schemaVersion", "runId", "tenantId", "snapshotId", "opportunityId", "campaignId", "campaignApprovalId", "planId", "planHash", "experimentId", "experimentHash", "experimentApprovalAuthorityRef", "envelopeId", "envelopeHash", "envelopeAuthorityAssertionId", "envelopeAuthorityAssertionHash", "actionId", "actionHash", "attemptId", "attemptState", "policyReceiptId", "policyReceiptHash", "outcomeEventIds", "createdAt", "manifestHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "snapshotId": { "type": "string", "minLength": 1 },
    "opportunityId": { "type": "string", "minLength": 1 },
    "campaignId": { "type": "string", "minLength": 1 },
    "campaignApprovalId": { "type": "string", "minLength": 1 },
    "planId": { "type": "string", "minLength": 1 },
    "planHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "experimentId": { "type": "string", "minLength": 1 },
    "experimentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "experimentApprovalAuthorityRef": { "type": "string", "minLength": 1 },
    "envelopeId": { "type": "string", "minLength": 1 },
    "envelopeHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "envelopeAuthorityAssertionId": { "type": "string", "minLength": 1 },
    "envelopeAuthorityAssertionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actionId": { "type": "string", "minLength": 1 },
    "actionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "attemptId": { "type": "string", "minLength": 1 },
    "attemptState": { "enum": ["CREATED", "SUBMITTING", "ACCEPTED", "COMPLETED", "DEFINITIVE_FAILURE", "RECONCILIATION_REQUIRED", "RECONCILED_COMPLETED", "RECONCILED_FAILED", "NOT_ACCEPTED"] },
    "policyReceiptId": { "type": "string", "minLength": 1 },
    "policyReceiptHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "outcomeEventIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "createdAt": { "type": "string", "format": "date-time" },
    "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
