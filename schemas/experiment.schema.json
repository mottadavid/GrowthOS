{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growthos.local/schemas/experiment.schema.json",
  "title": "GrowthOS Experiment",
  "type": "object",
  "required": ["schemaVersion", "experimentId", "tenantId", "opportunityId", "businessSnapshotId", "hypothesis", "actionPlanRef", "actionPlanHash", "primaryMetric", "successCriterion", "guardrails", "minimumSampleSize", "observationHorizonHours", "maxExposure", "maxSpendUsd", "state", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "experimentId": { "type": "string", "minLength": 1 },
    "tenantId": { "type": "string", "minLength": 1 },
    "opportunityId": { "type": "string", "minLength": 1 },
    "businessSnapshotId": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "actionPlanRef": { "type": "string", "minLength": 1 },
    "actionPlanHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "primaryMetric": { "type": "string", "minLength": 1 },
    "successCriterion": {
      "type": "object",
      "required": ["operator", "threshold"],
      "properties": {
        "operator": { "enum": ["GTE", "GT", "LTE", "LT", "EQ"] },
        "threshold": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "operator", "threshold"],
        "properties": {
          "metric": { "type": "string", "minLength": 1 },
          "operator": { "enum": ["GTE", "GT", "LTE", "LT", "EQ"] },
          "threshold": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "minimumSampleSize": { "type": "integer", "minimum": 1 },
    "observationHorizonHours": { "type": "integer", "minimum": 1 },
    "maxExposure": { "type": "integer", "minimum": 1 },
    "maxSpendUsd": { "type": "number", "minimum": 0 },
    "state": { "enum": ["DRAFT", "APPROVED", "RUNNING", "OBSERVING", "COMPLETED", "STOPPED", "INCONCLUSIVE", "RECONCILIATION_REQUIRED"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "approvalHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "approvedAt": { "type": ["string", "null"], "format": "date-time" },
    "approvedBy": { "type": ["string", "null"] },
    "approvalAuthorityRef": { "type": ["string", "null"] },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "closeDecision": { "type": ["string", "null"] },
    "closeReasons": { "type": "array", "items": { "type": "string" } },
    "closeEvidenceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "additionalProperties": false
}
